{
  "version": "0.9.2",
  "description": "Public API inventory for chota. Only selectors and custom properties documented in README/docs are included.",
  "customProperties": [
    "--bg-color",
    "--bg-secondary-color",
    "--color-primary",
    "--color-lightGrey",
    "--color-grey",
    "--color-darkGrey",
    "--color-error",
    "--color-success",
    "--grid-maxWidth",
    "--grid-gutter",
    "--font-size",
    "--font-color",
    "--font-family-sans",
    "--font-family-mono"
  ],
  "selectors": [
    ":root",
    "html",
    "body",
    "h1", "h2", "h3", "h4", "h5", "h6",
    "a",
    "a:hover:not(.button)",
    "button",
    "p",
    "blockquote",
    "dl dt",
    "hr",
    "table",
    "table.striped tr:nth-of-type(2n)",
    "td", "th",
    "thead", "tfoot",
    "code", "kbd", "pre", "samp", "tt",
    "pre code",
    "abbr[title]",
    "img",
    "fieldset",
    "iframe",
    ".container",
    ".row",
    ".row.reverse",
    ".col",
    ".col-1", ".col-2", ".col-3", ".col-4", ".col-5", ".col-6",
    ".col-7", ".col-8", ".col-9", ".col-10", ".col-11", ".col-12",
    ".col-1-md", ".col-2-md", ".col-3-md", ".col-4-md", ".col-5-md", ".col-6-md",
    ".col-7-md", ".col-8-md", ".col-9-md", ".col-10-md", ".col-11-md", ".col-12-md",
    ".col-1-lg", ".col-2-lg", ".col-3-lg", ".col-4-lg", ".col-5-lg", ".col-6-lg",
    ".col-7-lg", ".col-8-lg", ".col-9-lg", ".col-10-lg", ".col-11-lg", ".col-12-lg",
    "input:not([type=\"checkbox\"], [type=\"radio\"], [type=\"submit\"], [type=\"color\"], [type=\"button\"], [type=\"reset\"])",
    "select",
    "textarea",
    "textarea[type=\"text\"]",
    "input[type=\"checkbox\"]",
    "input[type=\"radio\"]",
    "input[type=\"range\"]",
    "progress",
    ".button",
    ".button.primary", ".button.secondary", ".button.dark", ".button.error", ".button.success",
    "[type=\"submit\"]",
    "input:disabled",
    "button:disabled",
    ".grouped",
    ".grouped.gapless",
    ".grouped.gapless > *:first-child",
    ".grouped.gapless > *:last-child",
    "input.error",
    "textarea.error",
    "input.success",
    "textarea.success",
    "[type=\"checkbox\"]",
    "[type=\"radio\"]",
    ".button + .button",
    ".button.outline",
    ".button.outline.primary",
    ".button.outline.secondary",
    ".button.outline.dark",
    ".button.clear",
    ".button.icon",
    ".button.icon > img",
    ".button.icon-only",
    "::placeholder",
    ".nav",
    ".nav img",
    ".nav > .container",
    ".nav-center", ".nav-left", ".nav-right",
    ".nav a",
    ".nav .brand",
    ".nav [aria-current=\"page\"]:not(.button)",
    ".nav .active:not(.button)",
    ".nav .brand img",
    ".nav .button",
    ".card",
    ".card p:last-child",
    ".card header > *",
    ".tabs",
    ".tabs a",
    ".tabs > .dropdown > summary",
    ".tabs > a[aria-current=\"page\"]",
    ".tabs > a.active",
    ".tabs > a:hover",
    ".tabs.is-full a",
    ".tag",
    ".tag.is-small",
    ".tag.is-large",
    ".tag + .tag",
    "details.dropdown",
    "details.dropdown > :last-child",
    ".bg-primary", ".bg-light", ".bg-dark", ".bg-grey", ".bg-error", ".bg-success",
    ".bd-primary", ".bd-light", ".bd-dark", ".bd-grey", ".bd-error", ".bd-success",
    ".text-primary", ".text-light", ".text-dark", ".text-grey", ".text-error", ".text-success", ".text-white",
    ".pull-right", ".pull-left",
    ".text-center", ".text-left", ".text-right", ".text-justify",
    ".text-uppercase", ".text-lowercase", ".text-capitalize",
    ".is-full-screen", ".is-full-width", ".is-full-height",
    ".is-vertical-align", ".is-horizontal-align",
    ".is-center", ".is-right", ".is-left",
    ".is-fixed",
    ".is-paddingless", ".is-marginless",
    ".is-pointer", ".is-rounded",
    ".clearfix",
    ".is-hidden",
    ".hide-xs", ".hide-sm", ".hide-md", ".hide-lg", ".hide-pr"
  ]
}
